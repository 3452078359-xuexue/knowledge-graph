Dish(菜品): EntityType
    desc: 可由多个餐饮场所提供的食物或饮品概念，如酸汤鱼。不保存某家店当日的菜单价格。
    properties:
        id(标识): Text
            desc: 全局唯一稳定标识，独立铸造，不由名称或来源拼接派生 —— 用「名称+章节」拼 id 会在同一对象被多次采集时产生重复实体
            index: Text
            constraint: NotNull
        name(名称): Text
            index: TextAndVector
            constraint: NotNull
            chunk: whole
        description(描述): Text
            index: TextAndVector
            chunk: paragraph
        type(菜品类型): Text
            index: Text
            constraint: NotNull,Enum="地方小吃,地方菜,民族菜,火锅,饮品"
        flavor(口味): Text
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        origin(发源地): Text
            index: Text
        originScenicArea(发源景区): ScenicArea
            desc: 地方小吃常与某古镇景区绑定，如青岩卤猪脚。用于「青岩有什么好吃的」这类问句
        sourceEntry(来源词条): Text
            desc: 由哪个百科词条的美食特产章节拆出
            index: Text
        picture(图片): Text
            index: Text
            constraint: MultiValue
        pictureDesc(图片说明): Text
