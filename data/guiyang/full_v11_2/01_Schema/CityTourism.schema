Product(商品): EntityType
    desc: 可购买的门票、套票、特产、体验票。现价与库存属实时数据，走 DynamicOverride。
    properties:
        id(标识): Text
            desc: 全局唯一稳定标识，独立铸造，不由名称或来源拼接派生 —— 用「名称+章节」拼 id 会在同一对象被多次采集时产生重复实体
            index: Text
            constraint: NotNull
        name(商品名称): Text
            index: TextAndVector
            constraint: NotNull
            chunk: whole
        description(商品描述): Text
            index: TextAndVector
            chunk: paragraph
        type(商品类型): Text
            index: Text
            constraint: NotNull,Enum="门票,套票,特产,体验票,接驳票"
        eligibility(适用人群): Text
            desc: 本票型适用于谁，如 儿童1.2米以下免票、60岁以上半价、学生凭证半价。「带孩子/老人有没有优惠票」此前全 schema 零字段可答
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        bookingRequired(是否需预约): Text
            desc: 【共享词表 BookingRequired】未确认时必须填未确认，不得默认为否
            index: Text
            constraint: Enum="是,否,部分时段需要,未确认"
        bookingChannel(预约渠道): Text
            desc: 形如 微信公众号「XX景区」、官网、美团。只说要预约不说在哪预约，等于没答
            index: TextAndVector
            chunk: whole
        advanceBookingDays(需提前天数): Integer
            desc: 需提前几天预约。0 表示当天可约
            optional: true
        refundPolicy(退改规则): Text
            desc: 能否退改、几天前可退。行前决策要权衡「先买会不会亏」
            index: TextAndVector
            chunk: whole
        validPeriod(有效期): Text
            desc: 形如 当日有效、3日内有效。套票与联票尤其需要
            index: Text
        price(基准价): Float
            desc: 参考量级；现价走 DynamicOverride
        unit(计价单位): Text
            index: Text
        isOnSale(是否有活动): Text
            constraint: Enum="是,否"
            index: Text
        saleDesc(活动描述): Text
            index: TextAndVector
            chunk: paragraph
        tips(购买须知): Text
            index: Text
        soldAt(售卖地点): Shopping
        ticketFor(对应景区): ScenicArea
        locatedInAdminArea(所属行政区): AdminArea
        picture(图片): Text
            index: Text
            constraint: MultiValue
        pictureDesc(图片说明): Text
            desc: 与 picture 顺序一一对应，供展示与图片检索
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        sourceId(来源ID): Text
            desc: 该实体的主来源，指向 DataSource.id。多源融合时它只代表主源，逐字段的出处见 fieldSources
            index: Text
            constraint: NotNull
        fieldSources(字段级来源): Text
            desc: 形如 name:src_amap、summary:src_baike。多源融合后整个实体只标一个主源说不清「名称来自高德、简介来自百科」，出问题时无法定位是哪个源写错的
            index: Text
            constraint: MultiValue
        fieldUpdatedAt(字段级更新时间): Text
            desc: 形如 ticketPrice:2026-09-10。用于回答「这个票价是什么时候采的」，比实体级 updatedAt 精确
            index: Text
            constraint: MultiValue
        batchId(采集批次): Text
            desc: 指向 CollectionBatch.batchId；未登记批次的数据不得入库
            index: Text
        externalIds(外部标识): Text
            desc: 跨源去重键。形如 amap:B0FFH..., baike:956442。同一对象在多次采集或多来源出现时，必须先按本字段查重命中已有实体再决定新建或更新；不得用名称拼 id 去重 —— 实测同一词条出现在两个采集目录时会产生重复实体
            index: Text
            constraint: NotNull,MultiValue
        lastVerifiedAt(最近核验时间): Text
            desc: 最近一次被人或权威源确认「现在仍然成立」的时间，区别于 lastSeenAt（只说明抓到过）。票价、营业时间挂在实体上，没有本字段就回答不了「这个价核过没有、多久没核了」；与来源的 refreshDays 一起判定该不该重采
            index: Text
        verifiedBy(核验人或来源): Text
            desc: 人工复核填工号，权威源自动核验填 DataSource.id
            index: Text
            optional: true
        dataQuality(数据质量): Text
            desc: 【共享词表 DataQuality】唯一的对外闸门。置为 ingestable 必须同时满足四条，缺一不可，且四条全部可由本 schema 的字段机器判定，不靠人记规则：① lastVerifiedAt 非空；② 每个对外字段的 fieldSources 指向的 DataSource.publishable=是，百科等不可发布来源写的字段必须先由官方源覆盖或人工确认；③ 该字段有断言级 SourceEvidence（带 field 与 quote），词条级证据不算；④ updatedAt 不晚于 lastVerifiedAt —— 核验之后内容又变过的必须自动退回 needs_review，否则改了价照样对外。needs_review 只进人工队列不对外；archived 为软删除，引用保留但不出现在任何对外查询 —— 删除一个景区平均波及 34 条引用，其中 18 条是 targetId 软引用不在图上，硬删会留下指向空对象的知识
            index: Text
            constraint: NotNull,Enum="ingestable,needs_review,rejected,archived"
        contentHash(内容哈希): Text
            desc: 对业务字段与关系一并求哈希；哈希不变时不得推进 updatedAt，否则无法回答「哪些真的变了」。必须把关系算进去 —— 关系是内容不是元数据。漏算会让「第一遍灌实体、第二遍补关系」的分步挂载中，第二遍因指纹未变被判为未变而整个吞掉，图上永远建不起边
            index: Text
        createdAt(首次入库时间): Text
            index: Text
        updatedAt(内容更新时间): Text
            desc: 内容变更时刻，不是抓取时刻
            index: Text
        lastSeenAt(最近抓取时间): Text
            desc: 最近一次抓到本记录的时间。contentHash 未变时只推进本字段、不推进 updatedAt —— 否则重复抓取会把「最近更新」刷屏，人工复核队列也会被无变化的记录淹没
            index: Text
        referencedBy(被引用数): Integer
            desc: 指向本实体的硬引用与软引用总数，入库时由灌数器维护。删除或下线前先读本字段判断波及面；为 0 才可安全硬删，否则一律走 dataQuality=archived 软删除
        archivedAt(归档时间): Text
            desc: 软删除时刻。归档后实体与引用全部保留，仅从对外查询中过滤，证据与历史知识仍可追溯
            index: Text
        archiveReason(归档原因): Text
            desc: 如「景区永久关闭」「重复实体已合并至 XX」。合并去重时被并方也走归档而非删除，以便回查
            index: Text
Route(路线): EntityType
    desc: 推荐游览路线。固定顺序，入口与出口明确。
    properties:
        id(标识): Text
            desc: 全局唯一稳定标识，独立铸造，不由名称或来源拼接派生 —— 用「名称+章节」拼 id 会在同一对象被多次采集时产生重复实体
            index: Text
            constraint: NotNull
        name(路线名称): Text
            index: TextAndVector
            constraint: NotNull
            chunk: whole
        description(路线描述): Text
            index: TextAndVector
            chunk: paragraph
        entryPoint(入口景点): Area
        exitPoint(出口景点): Area
        includes(包含景点): Area
            desc: 【已弃用，仅为兼容旧数据保留】单值且类型限死 Area，既排不了顺序也装不下 ScenicArea —— 青岩古镇、黔灵山公园都是 ScenicArea，按本字段根本进不了行程。新数据一律走 RouteVisits 关系
            optional: true
        duration(游览时长): Text
            index: Text
        suitableFor(适合人群): Text
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        rainCompatible(是否雨天可行): Text
            constraint: Enum="是,否"
            index: Text
        tips(路线贴士): Text
            index: Text
        picture(图片): Text
            index: Text
            constraint: MultiValue
        pictureDesc(图片说明): Text
            desc: 与 picture 顺序一一对应，供展示与图片检索
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        sourceId(来源ID): Text
            desc: 该实体的主来源，指向 DataSource.id。多源融合时它只代表主源，逐字段的出处见 fieldSources
            index: Text
            constraint: NotNull
        fieldSources(字段级来源): Text
            desc: 形如 name:src_amap、summary:src_baike。多源融合后整个实体只标一个主源说不清「名称来自高德、简介来自百科」，出问题时无法定位是哪个源写错的
            index: Text
            constraint: MultiValue
        fieldUpdatedAt(字段级更新时间): Text
            desc: 形如 ticketPrice:2026-09-10。用于回答「这个票价是什么时候采的」，比实体级 updatedAt 精确
            index: Text
            constraint: MultiValue
        batchId(采集批次): Text
            desc: 指向 CollectionBatch.batchId；未登记批次的数据不得入库
            index: Text
        externalIds(外部标识): Text
            desc: 跨源去重键。形如 amap:B0FFH..., baike:956442。同一对象在多次采集或多来源出现时，必须先按本字段查重命中已有实体再决定新建或更新；不得用名称拼 id 去重 —— 实测同一词条出现在两个采集目录时会产生重复实体
            index: Text
            constraint: NotNull,MultiValue
        lastVerifiedAt(最近核验时间): Text
            desc: 最近一次被人或权威源确认「现在仍然成立」的时间，区别于 lastSeenAt（只说明抓到过）。票价、营业时间挂在实体上，没有本字段就回答不了「这个价核过没有、多久没核了」；与来源的 refreshDays 一起判定该不该重采
            index: Text
        verifiedBy(核验人或来源): Text
            desc: 人工复核填工号，权威源自动核验填 DataSource.id
            index: Text
            optional: true
        dataQuality(数据质量): Text
            desc: 【共享词表 DataQuality】唯一的对外闸门。置为 ingestable 必须同时满足四条，缺一不可，且四条全部可由本 schema 的字段机器判定，不靠人记规则：① lastVerifiedAt 非空；② 每个对外字段的 fieldSources 指向的 DataSource.publishable=是，百科等不可发布来源写的字段必须先由官方源覆盖或人工确认；③ 该字段有断言级 SourceEvidence（带 field 与 quote），词条级证据不算；④ updatedAt 不晚于 lastVerifiedAt —— 核验之后内容又变过的必须自动退回 needs_review，否则改了价照样对外。needs_review 只进人工队列不对外；archived 为软删除，引用保留但不出现在任何对外查询 —— 删除一个景区平均波及 34 条引用，其中 18 条是 targetId 软引用不在图上，硬删会留下指向空对象的知识
            index: Text
            constraint: NotNull,Enum="ingestable,needs_review,rejected,archived"
        contentHash(内容哈希): Text
            desc: 对业务字段与关系一并求哈希；哈希不变时不得推进 updatedAt，否则无法回答「哪些真的变了」。必须把关系算进去 —— 关系是内容不是元数据。漏算会让「第一遍灌实体、第二遍补关系」的分步挂载中，第二遍因指纹未变被判为未变而整个吞掉，图上永远建不起边
            index: Text
        createdAt(首次入库时间): Text
            index: Text
        updatedAt(内容更新时间): Text
            desc: 内容变更时刻，不是抓取时刻
            index: Text
        lastSeenAt(最近抓取时间): Text
            desc: 最近一次抓到本记录的时间。contentHash 未变时只推进本字段、不推进 updatedAt —— 否则重复抓取会把「最近更新」刷屏，人工复核队列也会被无变化的记录淹没
            index: Text
        referencedBy(被引用数): Integer
            desc: 指向本实体的硬引用与软引用总数，入库时由灌数器维护。删除或下线前先读本字段判断波及面；为 0 才可安全硬删，否则一律走 dataQuality=archived 软删除
        archivedAt(归档时间): Text
            desc: 软删除时刻。归档后实体与引用全部保留，仅从对外查询中过滤，证据与历史知识仍可追溯
            index: Text
        archiveReason(归档原因): Text
            desc: 如「景区永久关闭」「重复实体已合并至 XX」。合并去重时被并方也走归档而非删除，以便回查
            index: Text
    relations:
        RouteVisits(路线游览): Area
            desc: 一条路线按顺序游览哪些景点。dayIndex 与 sequence 共同定序 —— 原 includes 字段单值且无序，表达不了「第二天上午先去A再去B」。与 RouteStaysAt 的 dayIndex 口径一致，两者合起来才拼得出完整日程
            properties:
                dayIndex(第几天): Integer
                    desc: 从 1 开始。一日游全部为 1
                    constraint: NotNull
                sequence(当日顺序): Integer
                    desc: 当天内的先后，从 1 开始。同日同序号视为可任选其一
                    constraint: NotNull
                suggestedDuration(建议停留): Text
                    desc: 形如 2小时。与景点自身的 visitDuration 可能不同 —— 行程里的停留是取舍后的安排
                    index: Text
                isOptional(可选项): Text
                    desc: 为是时表示时间紧可跳过。行程必须能表达「这站可选」，否则只能给一条僵硬的死路线
                    index: Text
                    constraint: Enum="是,否"
        RouteVisitsScenicArea(路线游览景区): ScenicArea
            desc: 同 RouteVisits，但目标是景区而非景区内的景点。分成两个关系而非放宽单个关系的目标类型，是因为本 DSL 的 relations 只能声明单一 endNode；查询层需合并两者按 dayIndex+sequence 排序
            properties:
                dayIndex(第几天): Integer
                    constraint: NotNull
                sequence(当日顺序): Integer
                    constraint: NotNull
                suggestedDuration(建议停留): Text
                    index: Text
                isOptional(可选项): Text
                    index: Text
                    constraint: Enum="是,否"
        RouteEatsAt(路线用餐): FoodAndBeverage
            desc: 行程中的用餐安排。住宿有 dayIndex、景点有了 RouteVisits，唯独吃饭没有 —— 而「中午在哪吃」是行程里最常被问的一环
            properties:
                dayIndex(第几天): Integer
                    constraint: NotNull
                mealTime(餐次): Text
                    index: Text
                    constraint: NotNull,Enum="早餐,午餐,晚餐,夜宵"
                isOptional(可选项): Text
                    index: Text
                    constraint: Enum="是,否"
        RouteStaysAt(路线住宿): Accommodation
            desc: 多日路线的住宿安排。缺它则「三天两晚怎么安排」只能给景点、串不了住宿
            properties:
                dayIndex(第几天): Integer
                    constraint: NotNull
                isRecommended(是否推荐): Text
                    constraint: Enum="是,否"
        RouteUsesProduct(路线用到商品): Product
            desc: 路线包含的门票、套票或接驳票，用于回答「这条线大概要花多少钱」
            properties:
                isIncluded(是否含在价内): Text
                    constraint: NotNull,Enum="是,否"
        RouteStartsFrom(路线出发枢纽): TransitHub
            desc: 外地游客从哪个枢纽接入本路线

TransitHub(交通枢纽): EntityType
    desc: 机场、火车站、客运站、地铁站、旅游集散中心。承载跨城到达，与只承载市内停靠的 TransitStop 分开。若已通过 spatialFacility 连接地图 POI，本实体只保留交通语义，不再复制坐标与 H3。
    properties:
        id(标识): Text
            desc: 全局唯一稳定标识，独立铸造，不由名称或来源拼接派生 —— 用「名称+章节」拼 id 会在同一对象被多次采集时产生重复实体
            index: Text
            constraint: NotNull
        name(名称): Text
            index: TextAndVector
            constraint: NotNull
            chunk: whole
        type(枢纽类型): Text
            index: Text
            constraint: NotNull,Enum="机场,火车站,高铁站,客运站,地铁站,集散中心"
        level(枢纽级别): Text
            index: Text
            constraint: Enum="国际,国家,区域,本地"
        accessGuide(到离指引): Text
            index: TextAndVector
            chunk: topic
        serviceItems(服务项目): Text
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        sourcePlaceId(来源地点ID): Text
            index: Text
        amapPoiId(高德POI ID): Text
            index: Text
        facilityClassCode(设施分类代码): Text
            index: Text
        facilityClassName(设施分类名称): Text
            index: Text
        detailType(设施细分类型): Text
            index: Text
        address(地址): Text
            index: TextAndVector
            chunk: whole
        province(省份): Text
            index: Text
        city(城市): Text
            index: Text
        district(区县): Text
            index: Text
        adcode(行政区划代码): Text
            index: Text
        telephone(联系电话): Text
            index: Text
        website(网站): Text
            index: Text
        sourceUrl(来源地址): Text
            index: Text
        verificationStatus(核验状态): Text
            index: Text
        qualityStatus(质量状态): Text
            index: Text
        qualityNotes(质量说明): Text
            index: TextAndVector
            chunk: paragraph
        scheduleNote(时刻动态说明): Text
            index: TextAndVector
            chunk: whole
        sourceCoordinateText(来源坐标原文): Text
            desc: 交通专题表里的原始坐标审计文本；当 spatialFacility 已承载标准坐标时，仅保留原文，不再复制成第二套地图点位
            index: Text
        spatialFacility(对应地图交通POI): TransitFacility
            desc: 只有来源地点ID精确命中高德空间底图时才建立；名称相似不建边。存在本引用时，地图展示与附近检索只使用目标 TransitFacility，本语义节点必须 geoPrecision=none 且不得再存 latitude/longitude/H3
        locatedInAdminArea(所属行政区): AdminArea
        latitude(纬度): Float
        longitude(经度): Float
        coordinateSystem(坐标系): Text
            desc: 本实体自带坐标时才填写；有 spatialFacility 时坐标系随目标设施读取，本字段必须留空
            index: Text
            constraint: Enum="WGS84,GCJ02,BD09,unknown"
        h3Index(空间网格): Text
            desc: 由同一组经纬度通过 h3-py 4.x latlng_to_cell 派生的真实 H3 R9 单元（平均边长约 200.8m），用于 1km 以内的就近检索。用法固定为「算含一圈安全冗余的 k 环 → 批量等值查 → 再算精确距离」：相距 50m 的两个 POI 可能落在不同格，只查同一格会静默漏召回。超过 1km 改用 h3IndexCoarse；按安全环估算，R9 在 5km 约 817 格、10km 约 2791 格。编码必须能通过 is_valid_cell，且分辨率与坐标重算结果一致
            index: Text
        h3IndexCoarse(粗粒度网格): Text
            desc: 由同一组经纬度通过 h3-py 4.x latlng_to_cell 派生的真实 H3 R7 单元（平均边长约 1.406km），用于 1km 以上的就近检索。按含一圈安全冗余的 k 环估算，3km、5km、10km 分别查 37、61、127 格；同场景 R9 分别约 331、817、2791 格。检索层按半径选字段并在粗筛后计算精确距离；本字段与 h3Index 必须成对填写并能由坐标重算验证
            index: Text
            optional: true
        geoPrecision(坐标精度): Text
            desc: exact=本语义节点拥有独立核验坐标；none=本节点无直接坐标或空间位置由 spatialFacility 承担。只有 exact 直接参与 H3；存在 spatialFacility 时必须为 none
            index: Text
            constraint: NotNull,Enum="exact,approx,none"
        picture(图片): Text
            index: Text
            constraint: MultiValue
        pictureDesc(图片说明): Text
            desc: 与 picture 顺序一一对应，供展示与图片检索
            index: TextAndVector
            constraint: MultiValue
            chunk: whole
        sourceId(来源ID): Text
            desc: 该实体的主来源，指向 DataSource.id。多源融合时它只代表主源，逐字段的出处见 fieldSources
            index: Text
            constraint: NotNull
        fieldSources(字段级来源): Text
            desc: 形如 name:src_amap、summary:src_baike。多源融合后整个实体只标一个主源说不清「名称来自高德、简介来自百科」，出问题时无法定位是哪个源写错的
            index: Text
            constraint: MultiValue
        fieldUpdatedAt(字段级更新时间): Text
            desc: 形如 ticketPrice:2026-09-10。用于回答「这个票价是什么时候采的」，比实体级 updatedAt 精确
            index: Text
            constraint: MultiValue
        batchId(采集批次): Text
            desc: 指向 CollectionBatch.batchId；未登记批次的数据不得入库
            index: Text
        externalIds(外部标识): Text
            desc: 跨源去重键。形如 amap:B0FFH..., baike:956442。同一对象在多次采集或多来源出现时，必须先按本字段查重命中已有实体再决定新建或更新；不得用名称拼 id 去重 —— 实测同一词条出现在两个采集目录时会产生重复实体
            index: Text
            constraint: NotNull,MultiValue
        lastVerifiedAt(最近核验时间): Text
            desc: 最近一次被人或权威源确认「现在仍然成立」的时间，区别于 lastSeenAt（只说明抓到过）。票价、营业时间挂在实体上，没有本字段就回答不了「这个价核过没有、多久没核了」；与来源的 refreshDays 一起判定该不该重采
            index: Text
        verifiedBy(核验人或来源): Text
            desc: 人工复核填工号，权威源自动核验填 DataSource.id
            index: Text
            optional: true
        dataQuality(数据质量): Text
            desc: 【共享词表 DataQuality】唯一的对外闸门。置为 ingestable 必须同时满足四条，缺一不可，且四条全部可由本 schema 的字段机器判定，不靠人记规则：① lastVerifiedAt 非空；② 每个对外字段的 fieldSources 指向的 DataSource.publishable=是，百科等不可发布来源写的字段必须先由官方源覆盖或人工确认；③ 该字段有断言级 SourceEvidence（带 field 与 quote），词条级证据不算；④ updatedAt 不晚于 lastVerifiedAt —— 核验之后内容又变过的必须自动退回 needs_review，否则改了价照样对外。needs_review 只进人工队列不对外；archived 为软删除，引用保留但不出现在任何对外查询 —— 删除一个景区平均波及 34 条引用，其中 18 条是 targetId 软引用不在图上，硬删会留下指向空对象的知识
            index: Text
            constraint: NotNull,Enum="ingestable,needs_review,rejected,archived"
        contentHash(内容哈希): Text
            desc: 对业务字段与关系一并求哈希；哈希不变时不得推进 updatedAt，否则无法回答「哪些真的变了」。必须把关系算进去 —— 关系是内容不是元数据。漏算会让「第一遍灌实体、第二遍补关系」的分步挂载中，第二遍因指纹未变被判为未变而整个吞掉，图上永远建不起边
            index: Text
        createdAt(首次入库时间): Text
            index: Text
        updatedAt(内容更新时间): Text
            desc: 内容变更时刻，不是抓取时刻
            index: Text
        lastSeenAt(最近抓取时间): Text
            desc: 最近一次抓到本记录的时间。contentHash 未变时只推进本字段、不推进 updatedAt —— 否则重复抓取会把「最近更新」刷屏，人工复核队列也会被无变化的记录淹没
            index: Text
        referencedBy(被引用数): Integer
            desc: 指向本实体的硬引用与软引用总数，入库时由灌数器维护。删除或下线前先读本字段判断波及面；为 0 才可安全硬删，否则一律走 dataQuality=archived 软删除
        archivedAt(归档时间): Text
            desc: 软删除时刻。归档后实体与引用全部保留，仅从对外查询中过滤，证据与历史知识仍可追溯
            index: Text
        archiveReason(归档原因): Text
            desc: 如「景区永久关闭」「重复实体已合并至 XX」。合并去重时被并方也走归档而非删除，以便回查
            index: Text
TransitLine(公交线路): EntityType
    desc: 用户口中的一条线，如 203 路。上下行是它的两个 TransitRoute。 把方向直接建在线路上，「203 路经过哪些站」就无法回答 —— 两个方向的站序不同。
    properties:
        id(标识): Text
            desc: 全局唯一稳定标识，独立铸造，不由名称或来源拼接派生 —— 用「名称+章节」拼 id 会在同一对象被多次采集时产生重复实体
            index: Text
            constraint: NotNull
        name(线路名称): Text
            index: TextAndVector
            constraint: NotNull
            chunk: whole
        shortName(线路简称): Text
            index: Text
        type(线路类型): Text
            index: Text
            constraint: NotNull,Enum="公交,快速公交,地铁,有轨电车,旅游专线,接驳"
        sourceMode(来源交通方式原文): Text
            index: Text
        basicFare(基础票价): Float
            desc: 基准值；调价走 DynamicOverride
        isTouristLine(是否旅游专线): Text
            constraint: Enum="是,否"
            index: Text
        operator(运营单位): Text
            index: Text
        lineCode(来源线路代码): Text
            index: Text
        evidenceStatus(证据状态): Text
            index: Text
        directionCount(方向数): Integer
        servedStopCount(覆盖站点数): Integer
        operators(运营单位集合): Text
            index: Text
            constraint: MultiValue
        coverageStatus(覆盖状态): Text
            index: Text
        qualityStatus(质量状态): Text
            index: Text
        qualityNotes(质量说明): Text
            index: TextAndVector
            chunk: paragraph
        completenessStatus(完整性状态): Text
            index: Text
        dataStatus(源数据状态): Text
            index: Text
        sourceUrl(来源地址): Text
            index: Text
        sourceId(来源ID): Text
            desc: 该实体的主来源，指向 DataSource.id。多源融合时它只代表主源，逐字段的出处见 fieldSources
            index: Text
            constraint: NotNull
        fieldSources(字段级来源): Text
            desc: 形如 name:src_amap、summary:src_baike。多源融合后整个实体只标一个主源说不清「名称来自高德、简介来自百科」，出问题时无法定位是哪个源写错的
            index: Text
            constraint: MultiValue
        fieldUpdatedAt(字段级更新时间): Text
            desc: 形如 ticketPrice:2026-09-10。用于回答「这个票价是什么时候采的」，比实体级 updatedAt 精确
            index: Text
            constraint: MultiValue
        batchId(采集批次): Text
            desc: 指向 CollectionBatch.batchId；未登记批次的数据不得入库
            index: Text
        externalIds(外部标识): Text
            desc: 跨源去重键。形如 amap:B0FFH..., baike:956442。同一对象在多次采集或多来源出现时，必须先按本字段查重命中已有实体再决定新建或更新；不得用名称拼 id 去重 —— 实测同一词条出现在两个采集目录时会产生重复实体
            index: Text
            constraint: NotNull,MultiValue
        lastVerifiedAt(最近核验时间): Text
            desc: 最近一次被人或权威源确认「现在仍然成立」的时间，区别于 lastSeenAt（只说明抓到过）。票价、营业时间挂在实体上，没有本字段就回答不了「这个价核过没有、多久没核了」；与来源的 refreshDays 一起判定该不该重采
            index: Text
        verifiedBy(核验人或来源): Text
            desc: 人工复核填工号，权威源自动核验填 DataSource.id
            index: Text
            optional: true
        dataQuality(数据质量): Text
            desc: 【共享词表 DataQuality】唯一的对外闸门。置为 ingestable 必须同时满足四条，缺一不可，且四条全部可由本 schema 的字段机器判定，不靠人记规则：① lastVerifiedAt 非空；② 每个对外字段的 fieldSources 指向的 DataSource.publishable=是，百科等不可发布来源写的字段必须先由官方源覆盖或人工确认；③ 该字段有断言级 SourceEvidence（带 field 与 quote），词条级证据不算；④ updatedAt 不晚于 lastVerifiedAt —— 核验之后内容又变过的必须自动退回 needs_review，否则改了价照样对外。needs_review 只进人工队列不对外；archived 为软删除，引用保留但不出现在任何对外查询 —— 删除一个景区平均波及 34 条引用，其中 18 条是 targetId 软引用不在图上，硬删会留下指向空对象的知识
            index: Text
            constraint: NotNull,Enum="ingestable,needs_review,rejected,archived"
        contentHash(内容哈希): Text
            desc: 对业务字段与关系一并求哈希；哈希不变时不得推进 updatedAt，否则无法回答「哪些真的变了」。必须把关系算进去 —— 关系是内容不是元数据。漏算会让「第一遍灌实体、第二遍补关系」的分步挂载中，第二遍因指纹未变被判为未变而整个吞掉，图上永远建不起边
            index: Text
        createdAt(首次入库时间): Text
            index: Text
        updatedAt(内容更新时间): Text
            desc: 内容变更时刻，不是抓取时刻
            index: Text
        lastSeenAt(最近抓取时间): Text
            desc: 最近一次抓到本记录的时间。contentHash 未变时只推进本字段、不推进 updatedAt —— 否则重复抓取会把「最近更新」刷屏，人工复核队列也会被无变化的记录淹没
            index: Text
        referencedBy(被引用数): Integer
            desc: 指向本实体的硬引用与软引用总数，入库时由灌数器维护。删除或下线前先读本字段判断波及面；为 0 才可安全硬删，否则一律走 dataQuality=archived 软删除
        archivedAt(归档时间): Text
            desc: 软删除时刻。归档后实体与引用全部保留，仅从对外查询中过滤，证据与历史知识仍可追溯
            index: Text
        archiveReason(归档原因): Text
            desc: 如「景区永久关闭」「重复实体已合并至 XX」。合并去重时被并方也走归档而非删除，以便回查
            index: Text
    relations:
        LineHasRoute(线路含方向): TransitRoute
            desc: 一条线路的上下行或环线。用户问「203 路」时先落到线路，再按方向取站序
            properties:
                direction(方向): Text
                    index: Text
                    constraint: NotNull,Enum="上行,下行,环线,单向序列"

TransitRoute(线路方向): EntityType
    desc: 一条线路的一个方向。首末班时间随季节调整，现值走 DynamicOverride。
    properties:
        id(标识): Text
            desc: 全局唯一稳定标识，独立铸造，不由名称或来源拼接派生 —— 用「名称+章节」拼 id 会在同一对象被多次采集时产生重复实体
            index: Text
            constraint: NotNull
        name(方向名称): Text
            index: TextAndVector
            constraint: NotNull
            chunk: whole
        direction(方向): Text
            index: Text
            constraint: NotNull,Enum="上行,下行,环线,单向序列"
        sourceMode(来源交通方式原文): Text
            index: Text
        belongsToLine(所属线路): TransitLine
        startStop(首站): Text
            index: Text
            constraint: NotNull
        endStop(末站): Text
            index: Text
            constraint: NotNull
        firstDeparture(首班时间): Text
            index: Text
        lastDeparture(末班时间): Text
            desc: 给错会把游客留在景区，属高危字段
            index: Text
        stopCount(站点数): Integer
        sourceDirection(来源方向原文): Text
            index: Text
        serviceDay(运营日期说明): Text
            index: Text
        fareDescription(票价说明): Text
            index: TextAndVector
            chunk: whole
        distanceKm(线路长度千米): Float
        operator(运营单位): Text
            index: Text
        busType(车辆或线路类型): Text
            index: Text
        polylineGcj02(GCJ02线路折线): Text
            desc: 来源折线原文，仅用于线路展示；不得当作站点坐标
            index: Text
        coordinateSystem(坐标系): Text
            desc: 声明 polylineGcj02 的坐标系；当前结构化交通折线固定为 GCJ02
            index: Text
            constraint: Enum="WGS84,GCJ02,BD09,unknown"
        coverageStatus(覆盖状态): Text
            index: Text
        qualityStatus(质量状态): Text
            index: Text
        qualityNotes(质量说明): Text
            index: TextAndVector
            chunk: paragraph
        dataStatus(源数据状态): Text
            index: Text
        sourceUrl(来源地址): Text
            index: Text
        sourceId(来源ID): Text
            desc: 该实体的主来源，指向 DataSource.id。多源融合时它只代表主源，逐字段的出处见 fieldSources
            index: Text
            constraint: NotNull
        fieldSources(字段级来源): Text
            desc: 形如 name:src_amap、summary:src_baike。多源融合后整个实体只标一个主源说不清「名称来自高德、简介来自百科」，出问题时无法定位是哪个源写错的
            index: Text
            constraint: MultiValue
        fieldUpdatedAt(字段级更新时间): Text
            desc: 形如 ticketPrice:2026-09-10。用于回答「这个票价是什么时候采的」，比实体级 updatedAt 精确
            index: Text
            constraint: MultiValue
        batchId(采集批次): Text
            desc: 指向 CollectionBatch.batchId；未登记批次的数据不得入库
            index: Text
        externalIds(外部标识): Text
            desc: 跨源去重键。形如 amap:B0FFH..., baike:956442。同一对象在多次采集或多来源出现时，必须先按本字段查重命中已有实体再决定新建或更新；不得用名称拼 id 去重 —— 实测同一词条出现在两个采集目录时会产生重复实体
            index: Text
            constraint: NotNull,MultiValue
        lastVerifiedAt(最近核验时间): Text
            desc: 最近一次被人或权威源确认「现在仍然成立」的时间，区别于 lastSeenAt（只说明抓到过）。票价、营业时间挂在实体上，没有本字段就回答不了「这个价核过没有、多久没核了」；与来源的 refreshDays 一起判定该不该重采
            index: Text
        verifiedBy(核验人或来源): Text
            desc: 人工复核填工号，权威源自动核验填 DataSource.id
            index: Text
            optional: true
        dataQuality(数据质量): Text
            desc: 【共享词表 DataQuality】唯一的对外闸门。置为 ingestable 必须同时满足四条，缺一不可，且四条全部可由本 schema 的字段机器判定，不靠人记规则：① lastVerifiedAt 非空；② 每个对外字段的 fieldSources 指向的 DataSource.publishable=是，百科等不可发布来源写的字段必须先由官方源覆盖或人工确认；③ 该字段有断言级 SourceEvidence（带 field 与 quote），词条级证据不算；④ updatedAt 不晚于 lastVerifiedAt —— 核验之后内容又变过的必须自动退回 needs_review，否则改了价照样对外。needs_review 只进人工队列不对外；archived 为软删除，引用保留但不出现在任何对外查询 —— 删除一个景区平均波及 34 条引用，其中 18 条是 targetId 软引用不在图上，硬删会留下指向空对象的知识
            index: Text
            constraint: NotNull,Enum="ingestable,needs_review,rejected,archived"
